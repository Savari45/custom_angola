<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="custom_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.name.widget</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']//field[@name='name']" position="attributes">
                <attribute name="widget">auto_fill</attribute>
            </xpath>
        </field>
    </record>
</odoo>
