<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    product code master views-->
    <record id="product_code_master_form_view" model="ir.ui.view">
        <field name="name">product.code.master.form</field>
        <field name="model">product.code.master</field>
        <field name="arch" type="xml">
            <form string="Product Code Master">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Enter Product Code"/>
                        </h1>
                    </div>
                    <group>
                        <field name="product_name" placeholder="Enter Product Name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_code_master_tree_view" model="ir.ui.view">
        <field name="name">product.code.master.tree</field>
        <field name="model">product.code.master</field>
        <field name="arch" type="xml">
            <list string="Product Code Master">
                <field name="name"/>
                <field name="product_name"/>
            </list>
        </field>
    </record>

    <record id="product_code_master_search_view" model="ir.ui.view">
        <field name="name">product.code.master.search</field>
        <field name="model">product.code.master</field>
        <field name="arch" type="xml">
            <search string="Search Product Codes">
                <field name="name"/>
                <field name="product_name"/>
            </search>
        </field>
    </record>

<!--    product template form view-->
    <record id="inherit_product_views_form" model="ir.ui.view">
        <field name="name">inherit_product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']//field[@name='name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <!-- Product Code First -->
            <xpath expr="//div[@class='oe_title']"
                   position="replace">

                <div class="oe_title">

                    <!-- Product Code -->
                    <label for="product_code_id"
                           string="Product Code"/>

                    <div class="mb-3">

                         <field name="product_code_id"
       widget="product_code_display"
       options="{'no_create_edit': False}"
       placeholder="Select or Create Product Code"/>

                    </div>


                    <!-- Original Odoo Product Name -->
                    <label for="name" string="Product"/>

                    <h1>
                        <div class="d-flex">

                            <field name="is_favorite"
                                   widget="boolean_favorite"
                                   class="me-2"
                                   nolabel="1"/>

                            <field class="text-break"
                                   name="name"
                                   options="{'line_breaks': False}"
                                   widget="text"
                                   placeholder="e.g. Cheese Burger"/>

                        </div>
                    </h1>

                </div>

            </xpath>
        </field>
    </record>

    <!--    product template  list view add product code -->
    <record id="product_template_tree_view_add_product_code" model="ir.ui.view">
        <field name="name">product.template.product.list.inherit.add.product.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_favorite']" position="before">
                <field name="product_code_name" string="Product Code"/>
            </xpath>
        </field>
    </record>

<!--    product form view-->
    <record id="inherit_product_normal_form_view"
        model="ir.ui.view">

    <field name="name">
        inherit.product.normal.form.view
    </field>

    <field name="model">product.product</field>

    <field name="inherit_id"
           ref="product.product_normal_form_view"/>

    <field name="arch" type="xml">

        <!-- Product Code First -->
            <xpath expr="//div[@class='oe_title']"
                   position="replace">

                <div class="oe_title">

                    <!-- Product Code -->
                    <label for="product_code_id"
                           string="Product Code"/>

                    <div class="mb-3">

                      <field name="product_code_id"
       widget="product_code_display"
       options="{'no_create_edit': False}"
       placeholder="Select or Create Product Code"/>


                    </div>


                    <!-- Original Odoo Product Name -->
                    <label for="name" string="Product"/>

                    <h1>
                        <div class="d-flex">

                            <field name="is_favorite"
                                   widget="boolean_favorite"
                                   class="me-2"
                                   nolabel="1"/>

                            <field class="text-break"
                                   name="name"
                                   options="{'line_breaks': False}"
                                   widget="text"
                                   placeholder="e.g. Cheese Burger"/>

                        </div>
                    </h1>

                </div>

            </xpath>

    </field>

</record>

<!--    product list view add product code-->
      <record id="product_tree_add_product_code" model="ir.ui.view">
        <field name="name">product.list.add.product.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="is_favorite" position="before">
                    <field name="product_code_name" string="Product Code"/>
            </field>
        </field></record>


</odoo>