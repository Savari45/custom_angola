<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<!--    product template form view-->
    <record id="inherit_product_views_form" model="ir.ui.view">
        <field name="name">inherit_product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']//field[@name='name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <!-- Product Code First -->
            <xpath expr="//div[@class='oe_title']"
                   position="replace">

                <div class="oe_title">

                    <!-- Product Code -->
                    <label for="product_code"
                           string="Product Code"/>

                    <div class="mb-3">

                        <field name="product_code"
                               placeholder="Product code"
                               required="1"
                               widget="auto_fill"/>

                    </div>


                    <!-- Original Odoo Product Name -->
                    <label for="name" string="Product"/>

                    <h1>
                        <div class="d-flex">

                            <field name="is_favorite"
                                   widget="boolean_favorite"
                                   class="me-2"
                                   nolabel="1"/>

                            <field class="text-break"
                                   name="name"
                                   options="{'line_breaks': False}"
                                   widget="text"
                                   placeholder="e.g. Cheese Burger"/>

                        </div>
                    </h1>

                </div>

            </xpath>
        </field>
    </record>

    <!--    product template  list view add product code -->
    <record id="product_template_tree_view_add_product_code" model="ir.ui.view">
        <field name="name">product.template.product.list.inherit.add.product.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_favorite']" position="before">
                <field name="product_code" width="40"/>
            </xpath>
        </field>
    </record>

<!--    product form view-->
    <record id="inherit_product_normal_form_view"
        model="ir.ui.view">

    <field name="name">
        inherit.product.normal.form.view
    </field>

    <field name="model">product.product</field>

    <field name="inherit_id"
           ref="product.product_normal_form_view"/>

    <field name="arch" type="xml">

        <!-- Product Code First -->
            <xpath expr="//div[@class='oe_title']"
                   position="replace">

                <div class="oe_title">

                    <!-- Product Code -->
                    <label for="product_code"
                           string="Product Code"/>

                    <div class="mb-3">

                        <field name="product_code"
                               placeholder="Product code"
                               required="1"
                               widget="auto_fill"/>

                    </div>


                    <!-- Original Odoo Product Name -->
                    <label for="name" string="Product"/>

                    <h1>
                        <div class="d-flex">

                            <field name="is_favorite"
                                   widget="boolean_favorite"
                                   class="me-2"
                                   nolabel="1"/>

                            <field class="text-break"
                                   name="name"
                                   options="{'line_breaks': False}"
                                   widget="text"
                                   placeholder="e.g. Cheese Burger"/>

                        </div>
                    </h1>

                </div>

            </xpath>

    </field>

</record>

<!--    product list view add product code-->
      <record id="product_tree_add_product_code" model="ir.ui.view">
        <field name="name">product.list.add.product.code</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="is_favorite" position="before">
                    <field name="product_code" width="40"/>
            </field>
        </field></record>


</odoo>